{
  "name": "auvik-mcp",
  "version": "0.1.0",
  "description": "MCP server for the Auvik network monitoring API",
  "type": "module",
  "main": "./dist/index.js",
  "author": "WYRE Technology",
  "license": "Apache-2.0",
  "homepage": "https://github.com/wyre-technology/auvik-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wyre-technology/auvik-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/wyre-technology/auvik-mcp/issues"
  },
  "keywords": [
    "auvik",
    "mcp",
    "model-context-protocol",
    "network-monitoring",
    "snmp",
    "msp",
    "rmm"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "start:http": "MCP_TRANSPORT=http node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "@wyre-technology/node-auvik": "^1.1.0",
    "dotenv": "^16.4.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.0",
    "@types/node": "^22.0.0",
    "semantic-release": "^25.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
