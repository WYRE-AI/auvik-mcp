# Auvik API credentials (stdio, and HTTP only when AUTH_MODE=env)
AUVIK_USERNAME=your_auvik_username
AUVIK_API_KEY=your_auvik_api_key
AUVIK_REGION=us1

# Server configuration
MCP_TRANSPORT=http
MCP_HTTP_PORT=8080
# Bind address. When MCP_HTTP_HOST is unset, the HTTP server binds 127.0.0.1.
# The container image sets 0.0.0.0 and requires CONDUIT_S2S_SECRET.
MCP_HTTP_HOST=127.0.0.1

# Required to start the HTTP transport. The process logs an error and exits
# non-zero when this is empty. Value is the gateway-provisioned service-to-service
# secret. Never commit a real secret.
CONDUIT_S2S_SECRET=

# Local development only. Set to exactly 1 to start HTTP without CONDUIT_S2S_SECRET.
# The server logs a loud warning and does not check X-Gateway-S2S. Do not set this
# in production or on a reachable interface.
# MCP_ALLOW_INSECURE_DEV=1

# Credential source for HTTP: env (process environment) or gateway (required
# x-auvik-username and x-auvik-api-key headers; no env fallback). The container
# image sets gateway. Stdio ignores this and reads AUVIK_* from the environment.
# AUTH_MODE=env

NODE_ENV=development
